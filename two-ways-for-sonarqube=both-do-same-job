2. Using Maven for SonarQube Analysis in a Java Project

pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                // Compile the Java project
                sh 'mvn clean package' // Build the project using Maven
            }
        }
        stage('SONARQUBE ANALYSIS') {
            steps {
                withSonarQubeEnv('sonar') { // Use SonarQube environment configured in Jenkins
                    sh 'mvn sonar:sonar' // Run Maven's Sonar plugin
                }
            }
        }
    }
}




